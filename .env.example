# ===== Home Server: переменные окружения =====
# Скопируй в .env и поправь:  cp .env.example .env
# (.env в .gitignore — пароли в git не попадут)

# --- Домен ---
AD_REALM=HOME.ARPA          # Kerberos realm / DNS-зона (верхний регистр). home.arpa — зарезервировано RFC 8375 для домашних сетей
AD_DOMAIN=HOME              # NetBIOS-имя домена (workgroup)
AD_DC_HOSTNAME=dc1          # hostname домен-контроллера
AD_DNS_FORWARDER=1.1.1.1    # куда DC форвардит все внешние DNS-запросы (обычно роутер, напр. 192.168.1.1)

# --- Пароли ---
# Пароль встроенного Administrator. Требования сложности Samba: 3 из 4 классов символов, от 7 символов
AD_ADMIN_PASSWORD=ChangeMe_Str0ng!

# Учётка для ввода файлового сервера в домен (можно оставить administrator)
AD_JOIN_USER=administrator
AD_JOIN_PASSWORD=ChangeMe_Str0ng!

# --- Telegram-прокси (service_tg_ws_proxy) ---
# Пусто = случайный секрет при каждом пересоздании контейнера (ссылку брать из логов заново).
# Для стабильной ссылки: openssl rand -hex 16 и пропиши сюда
TG_WS_PROXY_SECRET=

# --- Vaultwarden (service_vaultwarden, пароли) ---
# После регистрации всех членов семьи: false (новые аккаунты запрещены)
SIGNUPS_ALLOWED=true
# Токен админ-панели /admin (пусто = панель отключена). Для argon2-хэша:
# docker run --rm -it vaultwarden/server /vaultwarden hash
ADMIN_TOKEN=

# --- SearXNG (service_searxng) ---
# Публичный адрес поисковика (для корректных ссылок «поделиться»)
SEARXNG_BASE_URL=http://localhost:8888/

# --- Ace Stream Proxy (service_acestream_proxy) ---
# url m3u-плейлиста с каналами (group-title = категории в Web UI); пусто = без списка каналов
ACESTREAM_PLAYLIST_URL=

# --- Существующие сервисы (без изменений) ---
TZ=Europe/Moscow
